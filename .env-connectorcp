################## GLOBALS ##################

BASE_HOST=edc-proxy-connectorcp

################## Proxy (NGINX) ##################

# Protocol
NGINX_PROTOCOL=http

# Port for resolving DIDs (NGINX exposed port).
NGINX_EXPOSED_PORT=9879
NGINX_INTERNAL_PORT=83

################## ED-NODE: GLOBAL INSTANCE CONFIGURATION ##################

# Instance name 
ED_NODE_INSTANCE_NAME=connectorcp

# Container name (by default use the instance name)
ED_NODE_CONTAINER_IDENTIFIER=${ED_NODE_INSTANCE_NAME}

# Host/IP of ED-NODE
ED_NODE_DID_HOST=edc-proxy-${ED_NODE_INSTANCE_NAME}

# Port for resolving DIDs (NGINX exposed port).
ED_NODE_DID_PORT=${NGINX_INTERNAL_PORT}

# ED-NODE DID (based on instance). 
# curl http://<ED_NODE_DID_HOST>:<ED_NODE_DID_PORT>/<ED_NODE_INSTANCE_NAME>/.well-known/did.json must return the DID document created by `generateEDNodeFiles-KeysDIDVault.sh`.

ED_NODE_DID=did:web:${ED_NODE_DID_HOST}%3A${ED_NODE_DID_PORT}:${ED_NODE_INSTANCE_NAME}

################## Identity Provider (VCs): ISSUERSERVICE-VC ##################

# HOST
UNIMAAS_ISSUERSERVICEVC_PROTOCOL=http
UNIMAAS_ISSUERSERVICEVC_HOST=edc-proxy-issuerservicevc

# Issuer service (for resolving DID)
UNIMAAS_ISSUERSERVICEVC_DID_PORT=80
UNIMAAS_ISSUERSERVICEVC_NAME=issuerservicevc
UNIMAAS_ISSUERSERVICEVC_DID=did:web:${UNIMAAS_ISSUERSERVICEVC_HOST}%3A${UNIMAAS_ISSUERSERVICEVC_DID_PORT}:${UNIMAAS_ISSUERSERVICEVC_NAME}

# Issuer service (for obtaining signed VCs)
#UNIMAAS_ISSUERSERVICEVC_PORT=8500 #DEPRECATED (20250923): External access via NGINX redirects
UNIMAAS_ISSUERSERVICEVC_PORT=${UNIMAAS_ISSUERSERVICEVC_DID_PORT}
UNIMAAS_ISSUERSERVICEVC_PATH=/api/v1/issue-credential

# Issuer service (for obtaining signed VCs GAIA-X 22.06/24.11)
#GAIAX_ISSUERSERVICEVC_PORT=8500 #DEPRECATED (20250923): External access via NGINX redirects
GAIAX_ISSUERSERVICEVC_PORT=${UNIMAAS_ISSUERSERVICEVC_DID_PORT}
GAIAX_ISSUERSERVICEVC_PATH=/api/v1/issue-gaiax-credential-jwt

################## VCs Credential Manager Duplicate handling strategies ##################
# Options: SKIP_IF_EXISTS, REPLACE_ALWAYS, KEEP_NEWEST, KEEP_OLDEST, ALLOW_DUPLICATES
UNIMAAS_CREDENTIALS_MEMBERSHIP_DUPLICATE_STRATEGY=REPLACE_ALWAYS
UNIMAAS_CREDENTIALS_DATAPROCESSOR_DUPLICATE_STRATEGY=REPLACE_ALWAYS
UNIMAAS_CREDENTIALS_GAIAX_DUPLICATE_STRATEGY=REPLACE_ALWAYS
      
################## VCs Renewal strategy ##################
# Enable/Disable
UNIMAAS_CREDENTIALS_RENEWAL_ENABLED=true
      
# Verification interval in minutes (default every 1440 min = 1 day)
UNIMAAS_CREDENTIALS_RENEWAL_CHECK_INTERVAL_MINUTES=1440

# Margin of days before expiration to renew (default 30 days)
UNIMAAS_CREDENTIALS_RENEWAL_EXPIRY_THRESHOLD_DAYS=30

# ########################### XACML integration ###########################
XACML_VALIDATION_ENABLED=false
XACML_PDP_ENDPOINT=http://localhost:9092/pdp/verdict
XACML_DOMAIN=unimaas

################## Identity Provider (Autentication): KeyCloack ##################

# HOST
UNIMAAS_OIDC_IDP_PROTOCOL=http
UNIMAAS_OIDC_IDP_HOST=keycloak

# OIDC configuration IDP (Keycloak)
UNIMAAS_OIDC_IDP_PORT=8080
UNIMAAS_OIDC_IDP_REALM=unimaas
UNIMAAS_OIDC_IDP_PATH=/realms/${UNIMAAS_OIDC_IDP_REALM}/protocol/openid-connect/token

# ClientID & SecretID (keycloak)
UNIMAAS_OIDC_IDP_CLIENT_ID=${ED_NODE_DID}
UNIMAAS_OIDC_IDP_CLIENT_SECRET=6QU85OYXvSIu2gqs4p9c548nnUWxL5tM

