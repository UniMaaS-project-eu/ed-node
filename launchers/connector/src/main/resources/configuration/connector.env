edc.hostname=localhost
edc.participant.id=did:web:localhost%3A7083
# dataplane specific config
# edc.runtime.id=consumer-embedded-runtime

# control plane specific config
edc.iam.issuer.id=did:web:localhost%3A7083
web.http.port=8080
web.http.path=/api
web.http.management.port=8081
web.http.management.path=/api/management/
web.http.management.auth.type=tokenbased
web.http.management.auth.key=password

# Protocol API (DSP)
web.http.protocol.port=8082
web.http.protocol.path=/api/dsp

# Control API
web.http.control.port=8083
web.http.control.path=/api/control

# Catalog API
web.http.catalog.port=8084
web.http.catalog.path=/api/catalog
web.http.catalog_auth.type=tokenbased
web.http.catalog_auth.key=password

# Version API
web.http.version.port=8085
web.http.version.path=/api/version

# Internal dataplane ports
web.http.data.port=9091
web.http.data.path=/public

web.http.signaling.port=9092
web.http.signaling.path=/api/signaling

# Dataplane URLs
edc.dataplane.api.public.baseurl=http://localhost:9091/public
edc.dataplane.signaling.api.url=http://localhost:9092/api/signaling

# Token validation endpoints (use v3)
edc.dataplane.token.validation.endpoint=http://localhost:8083/api/control/v3/dataplane/token
edc.controlplane.validation-endpoint=http://localhost:8083/api/control/v3/dataplane/token

# API key for control plane
edc.dataplane.api.control.auth.apikey.value=password

# Unique ID of the dataplane
edc.dataplane.api.instance.id=dataplane-instance

# Public transfer endpoint (accessible from outside)
#edc.transfer.proxy.endpoint=http://localhost:11001/public

# Data plane public endpoint for CustomProxyDataPlaneExtension (PROXY) class
edc.dataplane.proxy.public.endpoint=http://localhost:11001/api/public

# Dataplane Public Port
web.http.public.port=11001
web.http.public.path=/api/public
# DEPRECATED - Data plane public endpoint for DataPlanePublicApiV2Extension class (":extensions:data-plane:data-plane-public-api-v2")
# edc.dataplane.api.public.baseurl=http://localhost:11001/public

# Dataplane registration (selector)
edc.dpf.selector.url=http://localhost:8083/api/control/v3/dataplanes

#edc.dataplane.allowed.source.types=HttpData,HttpProxy
#edc.dataplane.allowed.dest.types=HttpData,HttpProxy
#edc.dataplane.allowed.transfer.types=HttpData-PULL,HttpData-PUSH,HttpProxy

# ===========================================
# FederatedCatalog
# ===========================================

edc.catalog.cache.execution.delay.seconds=60
edc.catalog.cache.execution.period.seconds=300
edc.catalog.cache.partition.num.crawlers=1
edc.management.context.enabled=true

# ===========================================
# DID/DCP
# ===========================================

edc.iam.did.web.use.https=false
edc.iam.sts.privatekey.alias=key-1
edc.iam.sts.publickey.id=certificate

# edc.iam.sts.publickey.id=did:web:localhost%3A7083#key-1
# edc.iam.sts.privatekey.alias=did:web:localhost%3A7083-alias
edc.dsp.callback.address=http://localhost:8082/api/dsp

# ===========================================
# STS/OAUTH
# ===========================================

edc.iam.sts.oauth.client.secret.alias=did:web:localhost%3A7083-sts-client-secret
edc.iam.sts.oauth.client.id=did:web:localhost%3A7083
edc.iam.sts.oauth.token.url=http://localhost:7095/api/sts/token
# edc.iam.sts.oauth.audience=did:web:localhost%3A7083
# edc.iam.sts.oauth.scope=edc:catalog:read
# edc.iam.sts.token.decorator.scope=edc:catalog:read

# ===========================================
# EDR - REQUIRED BY 0.14.0
# ===========================================

edc.edr.cache.validity.period=600000
edc.edr.cache.cleanup.period=60000

# ===========================================
# TOKEN SETTINGS
# ===========================================

edc.transfer.proxy.token.verifier.publickey.alias=certificate
edc.transfer.proxy.token.signer.privatekey.alias=key-1
# edc.transfer.proxy.token.verifier.publickey.alias=did:web:localhost%3A7083#key-1
# edc.transfer.proxy.token.signer.privatekey.alias=did:web:localhost%3A7083-alias

# the size of the batch of entity fetched for every `TransferProcess` state machine iteration
edc.transfer.state-machine.batch-size=5
# the iteration wait time in milliseconds on the state machine while creating a `WaitStrategy` variable (default 1000)
edc.transfer.state-machine.iteration-wait-millis=5000

# ===========================================
# ISSUERSERVICE-VC LINK
# ===========================================

unimaas.issuerservicevc.did=did:web:localhost%3A9876

# ===========================================
# Require extra VC for CatalogRequest
# ===========================================

unimaas.enable.extra.vp.catalogrequest=false

# ===========================================
# VAULT LINK
# ===========================================

# Vault Server URL
edc.vault.hashicorp.url=http://localhost:8200

# Do NOT define the token here - it is passed dynamically via entrypoint
# edc.vault.hashicorp.token=root

# Timeout for connections to Vault
edc.vault.hashicorp.timeout.seconds=30

# Correct Path for KV v2 engine
edc.vault.hashicorp.api.secret.path=/v1/secret
edc.vault.hashicorp.api.health.check.path=/v1/sys/health

# Enable resolvers for certificates and private keys
edc.vault.certificate.resolver.enabled=true
edc.vault.privatekey.resolver.enabled=true

# Health check configuration
edc.vault.hashicorp.health.check.enabled=true
# edc.vault.hashicorp.health.check.standby.ok=false or true (Specifies if a vault in standby is healthy. This is useful when Vault is behind a non-configurable load balancer)
edc.vault.hashicorp.health.check.standby.ok=false

# Additional configuration for debugging
edc.vault.hashicorp.health.check.retry.retries=3
edc.vault.hashicorp.health.check.retry.interval.seconds=5

# ===========================================
# LOCAL MOCK REGISTRY LINK
# ===========================================

unimaas.mockregistry.context.url=http://localhost/main/context/2411


# ===========================================
# LOGGING Y DEBUG
# ===========================================

edc.log.level=DEBUG
edc.monitor.level=DEBUG
edc.web.rest.cors.enabled=true

# Logging Configuration for Debugging
java.util.logging.config.file=logging.properties

# ===========================================
# XACML integration
# ===========================================
xacml.validation.enabled=false
xacml.pdp.endpoint=http://localhost:9092/pdp/verdict
xacml.domain=test

# ===========================================
# POSTGREE PERSISTENCE
# ===========================================

# PRIORITY:
# 1-Environment variable
# 2-Configuration file
# 3-Vault

