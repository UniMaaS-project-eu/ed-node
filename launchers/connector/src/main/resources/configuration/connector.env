# edc.datasource.edr.user=edc_user
# edc.datasource.edr.password=edc_password

# Self-creation of schemas
edc.sql.schema.autocreate=true
# Connections Pool
edc.sql.pool.connections.max=10
edc.sql.pool.connections.min=3
