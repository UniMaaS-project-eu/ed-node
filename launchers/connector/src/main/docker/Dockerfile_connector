#COPY launchers/catalog-server/src ./launchers/catalog-server/src
#COPY launchers/catalog-server/build.gradle.kts ./launchers/catalog-server/build.gradle.kts
COPY launchers/connector/src ./launchers/connector/src
COPY launchers/connector/build.gradle.kts ./launchers/connector/build.gradle.kts
#COPY launchers/identity-hub/src ./launchers/identity-hub/src
#COPY launchers/identity-hub/build.gradle.kts ./launchers/identity-hub/build.gradle.kts
#COPY launchers/issuerservice/src ./launchers/issuerservice/src
