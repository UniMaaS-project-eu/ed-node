# Grant execution permissions to the Gradle Wrapper
RUN chmod +x gradlew gradlew.bat
RUN chmod +x /app/gradlew /app/gradlew.bat

# Build the application using Gradle (this will create the executable JAR)
RUN ./gradlew clean :launchers:connector:shadowJar --stacktrace

# Stage 2: Final image
FROM eclipse-temurin:23.0.2_7-jre-alpine

# Set the working directory
WORKDIR /app

RUN apk --no-cache add curl jq

# Copy the executable JAR from the build stage
COPY --from=builder /app/launchers/connector/build/libs/connector.jar /app/connector.jar

COPY launchers/connector/src/main/resources/configuration/connector.env config.properties

# Copy the deployment directory (needed for example to have the participants list) from the build stage
#COPY --from=builder /app/deployment ./deployment

COPY deployment ./deployment

COPY extensions/common/trust-framework-policies/trust-framework-policies-jsonld/src/main/resources/context ./resources/context


# Copy and prepare the dynamic startup script
COPY launchers/connector/src/main/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=5s --retries=10 CMD curl --fail http://localhost:8080/api/check/health

# REPLACED BY ENTRYPOINT USAGE
#ENV ENV_JVM_ARGS=""
#ENV SECRETS=""
#CMD ["sh", "-c", "exec java -Dedc.vault.secrets=\"$SECRETS\" -Djava.util.logging.config.file=/app/logging.properties -Djava.security.egd=file:/dev/urandom -Dedc.fs.config=./config.properties -jar connector.jar --log-level=debug"]

# Use the new entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
