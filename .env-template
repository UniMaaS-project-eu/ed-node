################## ED-NODE: GLOBAL INSTANCE CONFIGURATION ##################

# Instance name
ED_NODE_INSTANCE_NAME=connector1

# Container name (normalmente igual al nombre de instancia)
ED_NODE_CONTAINER_IDENTIFIER=${ED_NODE_INSTANCE_NAME}

# Host/IP of ED-NODE
ED_NODE_BASE_HOST=<edNodeHost>

# Port for resolving DIDs (NGINX exposed port).
ED_NODE_DID_PORT=9876

# ED-NODE DID (based on intance). 
# curl http://<host>:<port>/<nodeDIDPath>/.well-known/did.json must return the DID document created by `generateEDNodeFiles-KeysDIDVault.sh`.

ED_NODE_DID=did:web:${ED_NODE_BASE_HOST}%3A${ED_NODE_DID_PORT}:${ED_NODE_INSTANCE_NAME}

################## Identity Provider (VCs): ISSUERSERVICE ##################

# HOST
UNIMAAS_ISSUERSIGNER_PROTOCOL=http
UNIMAAS_ISSUERSIGNER_HOST=<IssuerSignerHost>

# Issuer service (for obtaining signed VCs)
UNIMAAS_ISSUERSIGNER_PORT=8500
UNIMAAS_ISSUERSIGNER_PATH=/api/v1/issue-credential

# Issuer service (for resolving DID)
UNIMAAS_ISSUERSIGNER_DID_PORT=9878
UNIMAAS_ISSUERSIGNER_NAME=issuerservice
UNIMAAS_ISSUERSIGNER_DID=did:web:${UNIMAAS_ISSUERSIGNER_HOST}%3A${UNIMAAS_ISSUERSIGNER_DID_PORT}:${UNIMAAS_ISSUERSIGNER_NAME}

################## Identity Provider (Autentication): KeyCloack ##################

# HOST
UNIMAAS_OIDC_IDP_PROTOCOL=http
UNIMAAS_OIDC_IDP_HOST=<KeycloakHost>

# OIDC configuration IDP (Keycloak)
UNIMAAS_OIDC_IDP_PORT=5080
UNIMAAS_OIDC_IDP_PATH=/realms/unimaas/protocol/openid-connect/token

# ClientID & SecretID (keycloak)
UNIMAAS_OIDC_IDP_CLIENT_ID=${ED_NODE_DID}
UNIMAAS_OIDC_IDP_CLIENT_SECRET=zFldH49vr0csQ1TOeIHbgjQesnywaI1Q

################## Identity Provider  ##################

# HOST
IH_HOST=${ED_NODE_BASE_HOST}

# PORTS
IH_API_PORT=7190
IH_CREDENTIALS_PORT=7191
IH_IDENTITY_PORT=7192
IH_DID_PORT=7193

# API Key 
IH_API_KEY=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=

################## Connector Environment Variables ##################

# HOST
CONNECTOR_HOST=${ED_NODE_BASE_HOST}

# PORTS
CONNECTOR_API_PORT=8190
CONNECTOR_API_MANAGEMENT_PORT=8191
CONNECTOR_CALLBACK_PORT=8192
CONNECTOR_API_CONTROL_PORT=8193
CONNECTOR_PUBLIC_API_PORT=11002

CONNECTOR_DATAPLANE_PUBLIC_PORT=9191
CONNECTOR_DATAPLANE_SIGNALING_PORT=9192

# API Key (IdentityHub)
CONNECTOR_IH_API_KEY=${IH_API_KEY}

# Require extra Credentials for Catalog Requests (DataProcessor)
CONNECTOR_UNIMAAS_ENABLE_EXTRA_VP_CATALOGREQUEST=true