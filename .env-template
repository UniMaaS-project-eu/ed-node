################## GLOBALS ##################

BASE_HOST=<Host>

################## Proxy (NGINX) ##################

# Protocol
NGINX_PROTOCOL=<NginxProtocol>

# Port for resolving DIDs (NGINX exposed port).
NGINX_EXPOSED_PORT=<NginxExposedPort>

################## ED-NODE: GLOBAL INSTANCE CONFIGURATION ##################

# Instance name (ex: connector1)
ED_NODE_INSTANCE_NAME=<instanceName>

# Container name (by default use the instance name)
ED_NODE_CONTAINER_IDENTIFIER=${ED_NODE_INSTANCE_NAME}

# Host/IP of ED-NODE
ED_NODE_DID_HOST=${BASE_HOST}

# Port for resolving DIDs (NGINX exposed port).
ED_NODE_DID_PORT=${NGINX_EXPOSED_PORT}

# ED-NODE DID (based on instance). 
# curl http://<ED_NODE_DID_HOST>:<ED_NODE_DID_PORT>/<ED_NODE_INSTANCE_NAME>/.well-known/did.json must return the DID document created by `generateEDNodeFiles-KeysDIDVault.sh`.

ED_NODE_DID=did:web:${ED_NODE_DID_HOST}%3A${ED_NODE_DID_PORT}:${ED_NODE_INSTANCE_NAME}

################## Identity Provider (VCs): ISSUERSERVICE-VC ##################

# HOST
UNIMAAS_ISSUERSERVICEVC_PROTOCOL=<IssuerServiceVCProtocol>
UNIMAAS_ISSUERSERVICEVC_HOST=<IssuerServiceVCHost>

# Issuer service (for resolving DID)
UNIMAAS_ISSUERSERVICEVC_DID_PORT=<IssuerServiceVCPort>
UNIMAAS_ISSUERSERVICEVC_NAME=issuerservicevc
UNIMAAS_ISSUERSERVICEVC_DID=did:web:${UNIMAAS_ISSUERSERVICEVC_HOST}%3A${UNIMAAS_ISSUERSERVICEVC_DID_PORT}:${UNIMAAS_ISSUERSERVICEVC_NAME}

# Issuer service (for obtaining signed VCs)
#UNIMAAS_ISSUERSERVICEVC_PORT=8500 #DEPRECATED (20250923): External access via NGINX redirects
UNIMAAS_ISSUERSERVICEVC_PORT=${UNIMAAS_ISSUERSERVICEVC_DID_PORT}
UNIMAAS_ISSUERSERVICEVC_PATH=/api/v1/issue-credential

# Issuer service (for obtaining signed VCs GAIA-X 22.06/24.11)
#GAIAX_ISSUERSERVICEVC_PORT=8500 #DEPRECATED (20250923): External access via NGINX redirects
GAIAX_ISSUERSERVICEVC_PORT=${UNIMAAS_ISSUERSERVICEVC_DID_PORT}
GAIAX_ISSUERSERVICEVC_PATH=/api/v1/issue-gaiax-credential-jwt

################## Identity Provider (Autentication): KeyCloack ##################

# HOST
UNIMAAS_OIDC_IDP_PROTOCOL=<KeycloakProtocol>
UNIMAAS_OIDC_IDP_HOST=<KeycloakHost>

# OIDC configuration IDP (Keycloak)
UNIMAAS_OIDC_IDP_PORT=<KeycloakPort>
UNIMAAS_OIDC_IDP_REALM=<KeycloakRealm>
UNIMAAS_OIDC_IDP_PATH=/realms/${UNIMAAS_OIDC_IDP_REALM}/protocol/openid-connect/token

# ClientID & SecretID (keycloak)
UNIMAAS_OIDC_IDP_CLIENT_ID=<KeycloakClientID>
UNIMAAS_OIDC_IDP_CLIENT_SECRET=<KeycloakSecretID>

################## Identity Provider  ##################

# HOST
IH_HOST=${BASE_HOST}

# PORTS
#IH_API_PORT=7190 --> DEPRECATED (20250923): Comunications will use container port (not exposed)
#IH_CREDENTIALS_PORT=7191 --> DEPRECATED (20250923): External access via NGINX redirects
#IH_IDENTITY_PORT=7192 -> DEPRECATED (20250923): External access via NGINX redirects
##IH_DID_PORT=7193 --> DEPRECATED (20250923): Not used
##IH_VERSION_PORT=7194 --> DEPRECATED (20250923): Not used
##IH_STS_PORT=7195 --> DEPRECATED (20250923): Not used

# API Key 
IH_API_KEY=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=

################## Connector Environment ##################

# HOST
CONNECTOR_HOST=${BASE_HOST}

# PORTS
#CONNECTOR_API_PORT=8190 --> DEPRECATED (20250923): Not used
#CONNECTOR_API_MANAGEMENT_PORT=8191 --> DEPRECATED (20250923): External access via NGINX redirects
#CONNECTOR_CALLBACK_PORT=8192 --> DEPRECATED (20250923): External access via NGINX redirects
#CONNECTOR_API_CONTROL_PORT=8193--> DEPRECATED (20250923): Not used
#CONNECTOR_CATALOG_PORT=8194 --> DEPRECATED (20250923): Not used
#CONNECTOR_VERSION_PORT=8195 --> DEPRECATED (20250923): Not used
#CONNECTOR_PUBLIC_API_PORT=11002 --> DEPRECATED (20250923): External access via NGINX redirects

#CONNECTOR_DATAPLANE_PUBLIC_PORT=9191 --> DEPRECATED (20250923): Not used
#CONNECTOR_DATAPLANE_SIGNALING_PORT=9192 --> DEPRECATED (20250923): Not used

# API Key (IdentityHub)
CONNECTOR_IH_API_KEY=${IH_API_KEY}

# Require extra Credentials for Catalog Requests (DataProcessor)
CONNECTOR_UNIMAAS_ENABLE_EXTRA_VP_CATALOGREQUEST=true
