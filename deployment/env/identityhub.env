edc.hostname=localhost
edc.participant.id=did:web:localhost%3A7083

web.http.port=7090
web.http.path=/api
web.http.credentials.port=7091
web.http.credentials.path=/api/credentials
web.http.identity.port=7092
web.http.identity.path=/api/identity
web.http.did.port=7093
web.http.did.path=/
web.http.version.port=7094
web.http.version.path=/api/version
web.http.sts.port=7095
web.http.sts.path=/api/sts
edc.iam.did.web.use.https=false
edc.iam.sts.privatekey.alias=key-1
edc.iam.sts.publickey.id=certificate
# edc.ih.iam.publickey.path=./deployment/assets/provider_public.pem
edc.ih.iam.id=did:web:localhost%3A7093
# IT IS PASSED THROUGH ENVIRONMENT VARIABLE...
# edc.ih.api.superuser.key=c3VwZXItdXNlcg==.c3VwZXItc2VjcmV0LWtleQo=

edc.iam.accesstoken.jti.validation=true


edc.log.level=DEBUG
edc.web.rest.cors.enabled=true

# ===========================================
# IDENTITYHUB ISSUER LINKING / CREDENTIAL UPLOAD
# ===========================================

#Parameter linked to the static loading of credentials in the MVD (IdentityHubExtension class)
# edc.mvd.credentials.path=/credentials

# Types of credentials that will be automatically requested at startup
# Based on the actual credentials you handle
# edc.cif.credential.types=DataProcessorCredential,MembershipCredential

# Parameters specific to DataProcessorCredential
# edc.cif.dataprocessor.level=processing
# edc.cif.dataprocessor.contractVersion=1.0.0

# Specific parameters for MembershipCredential
# edc.cif.membership.type=FullMember
# edc.cif.membership.website=www.tu-empresa.com
# edc.cif.membership.contact=contacto@tu-empresa.com

# Basic configuration of the credential issuing service
unimaas.issuersigner.protocol=http
unimaas.issuersigner.host=localhost
unimaas.issuersigner.port=8500
unimaas.issuersigner.path=/api/v1/issue-credential
unimaas.issuersigner.did=did:web:localhost%3A9876

# Optional configuration for multiple credentials (JSON), if not provided, a default credential will be used
# unimaas.credentials.config=[{"type":["VerifiableCredential","DataProcessorCredential"],"credentialSubject":{"contractVersion":"1.0.0","level": "processing"}},{"type":["VerifiableCredential", "MembershipCredential"],"credentialSubject":{"membership":{"membershipType":"UniMaaSMember","partner":"OdinS S.L.","contact":"jasanchez@odins.es","since":"2023-01-01T00:00:00Z"}}}]

# ===========================================
# IDENTITYHUB IDP-AUTH LINKING / CREDENTIAL UPLOAD
# ===========================================

unimaas.oidc.idp.protocol=http
unimaas.oidc.idp.host=localhost
unimaas.oidc.idp.port=8080
unimaas.oidc.idp.path=/realms/master/protocol/openid-connect/token
unimaas.oidc.idp.client.id=client_id
unimaas.oidc.idp.client.secret=client_secret

# ===========================================
# VAULT LINK
# ===========================================

# Vault Server URL
edc.vault.hashicorp.url=http://localhost:8200

# Do NOT define the token here - it is passed dynamically via entrypoint
# edc.vault.hashicorp.token=root

# Timeout for Vault connections
edc.vault.hashicorp.timeout.seconds=30

# Correct Path for KV v2 engine
edc.vault.hashicorp.api.secret.path=/v1/secret
edc.vault.hashicorp.api.health.check.path=/v1/sys/health

# Enable resolvers for certificates and private keys
edc.vault.certificate.resolver.enabled=true
edc.vault.privatekey.resolver.enabled=true

# Health check configuration
edc.vault.hashicorp.health.check.enabled=true
# edc.vault.hashicorp.health.check.standby.ok=false or true (Specifies if a vault in standby is healthy. This is useful when Vault is behind a non-configurable load balancer)
edc.vault.hashicorp.health.check.standby.ok=false

# Additional configuration for debugging
edc.vault.hashicorp.health.check.retry.retries=3
edc.vault.hashicorp.health.check.retry.interval.seconds=5
