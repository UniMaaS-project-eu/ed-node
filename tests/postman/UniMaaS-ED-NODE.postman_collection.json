				{
					"name": "Accesing to Connector2",
					"item": [
						{
							"name": "CatalogRequest to Connector2",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"const responseJson = pm.response.json();",
											"",
											"const offerTest = responseJson[\"dcat:dataset\"][\"odrl:hasPolicy\"][\"@id\"];",
											"pm.environment.set(\"offerTest\", offerTest);",
											"",
											"const assetTest = responseJson[\"dcat:dataset\"][\"id\"];",
											"pm.environment.set(\"assetTest\", assetTest);",
											"",
											"const participantId = responseJson[\"dspace:participantId\"];",
											"pm.environment.set(\"participantId\", participantId);",
											""
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "apikey",
									"apikey": [
										{
											"key": "value",
											"value": "password",
											"type": "string"
										},
										{
											"key": "in",
											"value": "header",
											"type": "string"
										},
										{
											"key": "key",
											"value": "x-api-key",
											"type": "string"
										}
									]
								},
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"@context\": {\n        \"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"\n    },\n    \"@type\": \"CatalogRequest\",\n    \"protocol\": \"dataspace-protocol-http\",\n    \"counterPartyAddress\": \"http://{{conector2IP}}:8292/api/dsp\",\n    \"counterPartyId\": \"did:web:{{conector2IP}}%3A9877:connector2\",\n    \"querySpec\": {\n        \"offset\": 0,\n        \"limit\": 50\n    }\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "http://localhost:8191/api/management/v3/catalog/request",
									"protocol": "http",
									"host": [
										"localhost"
									],
									"port": "8191",
									"path": [
										"api",
										"management",
										"v3",
										"catalog",
										"request"
									]
								}
							},
							"response": []
						},
						{
							"name": "Initiate negotiation (with Connector2) ALL",
							"event": [
								{
