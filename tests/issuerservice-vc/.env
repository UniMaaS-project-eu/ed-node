################## GLOBALS ##################

BASE_HOST=edc-proxy-issuerservicevc

################## Proxy (NGINX) ##################

# External host port. From the host machine: http://localhost:7000
NGINX_EXPOSED_PORT=7000

# Internal Docker port. From other containers: http://edc-proxy-issuerservicevc:80
NGINX_INTERNAL_PORT=80

# Instance name
ISSUERSERVICEVC_INSTANCE_NAME=issuerservicevc

################## IssuerService-VC ##################

# Internal Docker host for DID resolution
ISSUERSERVICEVC_HOST=edc-proxy-${ISSUERSERVICEVC_INSTANCE_NAME}

# Internal Docker port for DID resolution
ISSUERSERVICEVC_DID_PORT=${NGINX_INTERNAL_PORT}

# DID based on internal Docker name
ISSUER_DID=did:web:${ISSUERSERVICEVC_HOST}%3A${ISSUERSERVICEVC_DID_PORT}:${ISSUERSERVICEVC_INSTANCE_NAME}

# Context for signed/issued VCs
VC_CONTEXT_URL=http://edc-proxy-connector1:80/main/context/2411

# VCs valid time in days
EXPIRY_DAYS=365