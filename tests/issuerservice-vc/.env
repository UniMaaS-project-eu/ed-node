################## GLOBALS ##################

BASE_HOST=<Host>

################## Proxy (NGINX) ##################

# Port for resolving DIDs (NGINX exposed port).
NGINX_EXPOSED_PORT=<NginxExposedPort>

# Instance name
ISSUERSERVICEVC_INSTANCE_NAME=issuerservicevc

################## IssuerService-VC ##################

# Host
ISSUERSERVICEVC_HOST=${BASE_HOST}

# Port
#ISSUERSERVICEVC_PORT=8500 --> DEPRECATED (20250923): External access via NGINX redirects

# DID RESOLVER PORT (NGINX)
ISSUERSERVICEVC_DID_PORT=${NGINX_EXPOSED_PORT}

# DID (based on instance). 
# curl http://<ISSUERSERVICEVC_HOST>:<ISSUERSERVICEVC_DID_PORT>/<ISSUERSERVICEVC_INSTANCE_NAME>/.well-known/did.json must return the DID document created by `generateEDNodeFiles-KeysDIDVault.sh`.

ISSUER_DID=did:web:${ISSUERSERVICEVC_HOST}%3A${ISSUERSERVICEVC_DID_PORT}:${ISSUERSERVICEVC_INSTANCE_NAME}

# VCs valid time (days)
EXPIRY_DAYS=365
